{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kindric",
  "identifier": "io.github.louisstani.kindric",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "kindric",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  }
}
