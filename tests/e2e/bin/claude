#!/usr/bin/env python3
"""A fake Claude Code for kindric's end-to-end tests (decision 310): it answers what kindric asks
and writes the files kindric reads, in the shapes Claude Code 2.1.323 gives, without any model.

    claude --version                      "2.1.323 (Claude Code)"
    claude auth status --json             logged in for an account (CLAUDE_CONFIG_DIR set), not for ~/.claude;
                                          the login expires at the date in fake/login-expires, else 2027
    claude auth login                     a new login, noted in fake/logins.log: it expires in 2027
    claude agents --json [--all]          the sessions of the account, stopped ones with --all
    claude [options] --bg [-n name] TASK  a background session; TASK may hold "work:N": it works N
                                          seconds (2 by default), then waits for the user;
                                          each "touch:NAME" writes the file NAME in its folder,
                                          "cd:PATH" goes into PATH, "commit:MESSAGE" commits there;
                                          each "image:NAME" writes a PNG its answer cites;
                                          "ask:WHAT" ends the turn on a question of Claude Code
                                          (waitingFor WHAT, "_" for spaces) instead of waiting;
                                          at its start and after each turn, the asyncRewake hooks of
                                          its --settings run in the background: exit code 2 starts a
                                          turn with their error output
    claude attach ID                      a terminal on the session: each line typed (or pasted, with
                                          bracketed paste) is a new turn; a stopped session is
                                          started again, waiting
    claude stop ID / claude rm ID         rm refuses a session whose name starts with "unpushed", as
                                          Claude Code does for a worktree with commits not pushed
    claude mcp add [-s user] NAME -- CMD  the server in the account's .claude.json (~/.claude.json without one)

Options kindric-accounts adds (--settings, --mcp-config=…, --append-system-prompt-file …) are
ignored, but a session keeps the words it was started with ("args"). Everything lives in the
account's folder: fake/sessions.json, sessions/<pid>.json, jobs/<id>/state.json, and the transcript
projects/<folder>/<session id>.jsonl, a prompt and an answer per turn.
"""
import json
import os
import re
import signal
import struct
import subprocess
import sys
import time
import uuid
import zlib

VERSION = "2.1.323"
# Options that take the next word as their value, when not written with "=".
WITH_VALUE = {"--settings", "--mcp-config", "--append-system-prompt-file", "--plugin-dir", "--model", "--setting-sources", "--permission-mode", "-n", "--name", "-s", "--scope"}


def config_dir():
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")


def now_ms():
    return int(time.time() * 1000)


def iso(ms):
    return time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(ms / 1000)) + f".{ms % 1000:03d}Z"


def write_json(path, value):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    temporary = f"{path}.{os.getpid()}.tmp"
    with open(temporary, "w") as out:
        json.dump(value, out)
    os.replace(temporary, path)


def registry_path():
    return os.path.join(config_dir(), "fake", "sessions.json")


def load():
    try:
        with open(registry_path()) as source:
            return json.load(source)
    except (OSError, ValueError):
        return []


def save(sessions):
    write_json(registry_path(), sessions)


def find(sessions, wanted):
    for session in sessions:
        if wanted in (session["id"], session["sessionId"], session.get("name")):
            return session
    return None


def alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def set_state(session_id, status, state, detail, waiting_for=None):
    """What the session is doing: its process file (status, and waitingFor while a question of
    Claude Code is on its screen) and its job file (state, detail)."""
    sessions = load()
    session = find(sessions, session_id)
    if session is None:
        return
    session.update(status=status, state=state, detail=detail)
    save(sessions)
    if session.get("pid"):
        process = {
            "pid": session["pid"], "sessionId": session["sessionId"], "cwd": session["cwd"], "startedAt": session["startedAt"],
            "version": VERSION, "kind": "bg", "name": session.get("name", ""), "jobId": session["id"],
            "updatedAt": now_ms(), "status": status, "statusUpdatedAt": now_ms(),
        }
        if waiting_for:
            process["waitingFor"] = waiting_for
        write_json(os.path.join(config_dir(), "sessions", f"{session['pid']}.json"), process)
    tempo = {"busy": "active", "waiting": "blocked"}.get(status, "idle")
    write_json(os.path.join(config_dir(), "jobs", session["id"], "state.json"), {
        "state": state, "detail": detail, "tempo": tempo,
        "name": session.get("name", ""), "sessionId": session["sessionId"], "cliVersion": VERSION,
        "cwd": session["cwd"], "createdAt": iso(session["startedAt"]), "updatedAt": iso(now_ms()),
    })


def transcript_path(session):
    """Where Claude Code writes a session's transcript: its folder with each "/" and "." as "-"."""
    folder = re.sub(r"[/.]", "-", session["cwd"])
    return os.path.join(config_dir(), "projects", folder, f"{session['sessionId']}.jsonl")


def write_transcript(session_id, entry, cwd=None):
    """Adds one entry to the session's transcript, in the shape Claude Code 2.1.323 writes; `cwd`
    the folder the session is in, its own by default."""
    session = find(load(), session_id)
    if session is None:
        return
    path = transcript_path(session)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    entry.update(sessionId=session["sessionId"], cwd=cwd or session["cwd"], timestamp=iso(now_ms()), uuid=str(uuid.uuid4()))
    with open(path, "a") as out:
        # Compact, as Claude Code writes it: kindric looks for "name":"value" in the bytes.
        out.write(json.dumps(entry, separators=(",", ":")) + "\n")


def tool_result(session_id, cwd, output):
    """What a tool gave back, as Claude Code writes it in the transcript, in the folder `cwd`."""
    write_transcript(session_id, {"type": "user", "message": {"role": "user", "content": [
        {"type": "tool_result", "tool_use_id": f"toolu_{uuid.uuid4().hex[:12]}", "content": output}]}}, cwd)


def write_files(session_id, task):
    """The steps of the task, in order: "touch:NAME" writes the file NAME in the folder the session
    is in, "cd:PATH" goes into PATH (relative to its own folder), "commit:MESSAGE" commits every
    change of that folder with git ("_" for spaces), its output in the transcript."""
    session = find(load(), session_id)
    if session is None:
        return
    here = session["cwd"]
    for step, value in re.findall(r"\b(touch|cd|commit):(\S+)", task or ""):
        if step == "touch":
            with open(os.path.join(here, value), "w") as out:
                out.write(f"written by {session.get('name') or session['id']}\n")
        elif step == "cd":
            here = os.path.normpath(os.path.join(here, value))
            tool_result(session_id, here, "")
        else:
            subprocess.run(["git", "add", "-A"], cwd=here, capture_output=True)
            done = subprocess.run(["git", "commit", "-m", value.replace("_", " ")], cwd=here, capture_output=True, text=True)
            tool_result(session_id, here, done.stdout + done.stderr)


def question_of(task):
    """What the turn ends waiting for, from "ask:WHAT" (Claude Code's words, "_" for spaces)."""
    match = re.search(r"ask:(\S+)", task or "")
    return match.group(1).replace("_", " ") if match else None


def work_seconds(task):
    match = re.search(r"work:(\d+)", task or "")
    return int(match.group(1)) if match else 2


# While it works, Claude Code rewrites its job file every few steps, and only that file: its
# process file changes at the start and the end of the turn (seen on 2.1.323).
PROGRESS_EVERY = 10


def job_progress(session_id, detail):
    session = find(load(), session_id)
    if session is None:
        return
    write_json(os.path.join(config_dir(), "jobs", session["id"], "state.json"), {
        "state": "working", "detail": detail, "tempo": "active",
        "name": session.get("name", ""), "sessionId": session["sessionId"], "cliVersion": VERSION,
        "cwd": session["cwd"], "createdAt": iso(session["startedAt"]), "updatedAt": iso(now_ms()),
    })


def turn(session_id, task):
    """One turn: busy for the time the task says, then waiting for the user."""
    set_state(session_id, "busy", "working", f"working on: {task[:60]}")
    write_transcript(session_id, {"type": "user", "message": {"role": "user", "content": task}})
    write_files(session_id, task)
    end = time.time() + work_seconds(task)
    step = 0
    while time.time() < end:
        time.sleep(min(PROGRESS_EVERY, max(end - time.time(), 0)))
        step += 1
        if time.time() < end:
            job_progress(session_id, f"step {step} of: {task[:50]}")
    question = question_of(task)
    if question:
        # Seen on Claude Code 2.1.326: "waiting" in the process file and in agents --json.
        set_state(session_id, "waiting", "blocked", "waiting for you", question)
        return
    answer = f"done: {task}"
    images = write_images(session_id, task)
    if images:
        answer += "\n\nI made " + ", ".join(f"`{name}`" for name in images) + "."
    write_transcript(session_id, {"type": "assistant", "message": {"role": "assistant", "content": [{"type": "text", "text": answer}]}})
    set_state(session_id, "idle", "blocked", "waiting for you")
    start_rewake(session_id, "Stop")


def png(width, height, rgb):
    """A PNG of one colour."""
    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)
    rows = b"".join(b"\x00" + bytes(rgb) * width for _ in range(height))
    header = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    return b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", header) + chunk(b"IDAT", zlib.compress(rows)) + chunk(b"IEND", b"")


def write_images(session_id, task):
    """Each "image:NAME" of the task: a PNG written in the session's folder, which its answer cites."""
    session = find(load(), session_id)
    names = re.findall(r"\bimage:(\S+)", task or "")
    for name in names if session else []:
        with open(os.path.join(session["cwd"], name), "wb") as out:
            out.write(png(8, 6, (200, 80, 30)))
    return names if session else []


def rewake_hooks(session, event):
    """The commands the session's settings (--settings) run in the background for `event`, the
    hooks marked asyncRewake: Claude Code starts a turn with the error output of one that exits 2."""
    args = session.get("args", [])
    try:
        with open(args[args.index("--settings") + 1]) as source:
            settings = json.load(source)
    except (ValueError, IndexError, OSError):
        return []
    return [hook["command"] for matcher in settings.get("hooks", {}).get(event, []) for hook in matcher.get("hooks", [])
            if hook.get("asyncRewake") and hook.get("command")]


def start_rewake(session_id, event):
    """Runs the session's asyncRewake hooks of `event`, each in a process of its own, noted in the
    session's "hooks" so that stopping the session ends them."""
    sessions = load()
    session = find(sessions, session_id)
    if session is None:
        return
    for command in rewake_hooks(session, event):
        process = subprocess.Popen([sys.executable, os.path.abspath(__file__), "--fake-rewake", session_id, event, command],
                                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        session.setdefault("hooks", []).append(process.pid)
    save(sessions)


def rewake(session_id, event, command):
    """One asyncRewake hook: given what Claude Code gives a hook; exit code 2 wakes the session,
    its error output the prompt of the new turn."""
    session = find(load(), session_id)
    if session is None:
        return
    asked = {"session_id": session["sessionId"], "transcript_path": transcript_path(session), "cwd": session["cwd"], "hook_event_name": event}
    done = subprocess.run(command, shell=True, input=json.dumps(asked), capture_output=True, text=True, cwd=session["cwd"])
    session = find(load(), session_id)
    if done.returncode == 2 and session is not None and alive(session.get("pid")):
        turn(session_id, done.stderr.strip())


def worker(session_id, task):
    """The session's process: it lives until stopped, like a background session of Claude Code.
    Without a task, it was stopped and is started again: it waits for the user."""
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    # The registry is written by the process that started this one once it has its pid: writing
    # it before would lose that pid.
    deadline = time.time() + 5
    while time.time() < deadline and (find(load(), session_id) or {}).get("pid") != os.getpid():
        time.sleep(0.05)
    start_rewake(session_id, "SessionStart")
    if task is None:
        set_state(session_id, "idle", "blocked", "waiting for you")
    else:
        turn(session_id, task)
    while True:
        time.sleep(3600)


def spawn(session_id, task):
    """Starts the session's process and records its pid; task None starts a stopped session again."""
    mode = ["--fake-resume", session_id] if task is None else ["--fake-worker", session_id, task]
    process = subprocess.Popen([sys.executable, os.path.abspath(__file__), *mode],
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    sessions = load()
    find(sessions, session_id).update(pid=process.pid, status="idle" if task is None else "busy")
    save(sessions)


def background(args, task):
    name = None
    for index, arg in enumerate(args):
        if arg in ("-n", "--name") and index + 1 < len(args):
            name = args[index + 1]
    sessions = load()
    session = {"id": uuid.uuid4().hex[:8], "sessionId": str(uuid.uuid4()), "name": name or "", "cwd": os.getcwd(),
               "startedAt": now_ms(), "pid": None, "status": "busy", "state": "working", "detail": "", "args": args}
    sessions.append(session)
    save(sessions)
    spawn(session["sessionId"], task or "")
    print(f"backgrounded · {session['id']}" + (f" · {name}" if name else ""))
    return 0


def agents(args):
    show_all = "--all" in args
    listed = []
    for session in load():
        running = alive(session.get("pid"))
        if not running and not show_all:
            continue
        entry = {"id": session["id"], "cwd": session["cwd"], "kind": "background", "startedAt": session["startedAt"],
                 "sessionId": session["sessionId"]}
        if session.get("name"):
            entry["name"] = session["name"]
        if running:
            entry.update(pid=session["pid"], status=session["status"], state=session["state"])
        else:
            entry["state"] = "stopped"
        listed.append(entry)
    print(json.dumps(listed))
    return 0


BRACKETED_PASTE_ON = "\x1b[?2004h"
PASTE_MARKS = re.compile("\x1b\\[20[01]~")


def attach(wanted):
    session = find(load(), wanted)
    if session is None:
        print(f"No job matching {wanted}", file=sys.stderr)
        return 1
    # Like Claude Code: attaching to a stopped session starts it again.
    if not alive(session.get("pid")):
        spawn(session["sessionId"], None)
    print(f"fake claude · {session.get('name') or session['id']} · {session['cwd']}")
    # Like Claude Code once its prompt reads input: bracketed paste on (what kindric waits for
    # before typing an answer), and a pasted block read without its markers.
    print(f"{BRACKETED_PASTE_ON}❯ ", end="", flush=True)
    for line in sys.stdin:
        line = PASTE_MARKS.sub("", line).strip()
        if line:
            print(f"you said: {line}")
            child = subprocess.Popen([sys.executable, os.path.abspath(__file__), "--fake-turn", session["sessionId"], line],
                                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            del child
        print("❯ ", end="", flush=True)
    return 0


def stop(wanted, remove):
    sessions = load()
    session = find(sessions, wanted)
    if session is None:
        print(f"No job matching {wanted}", file=sys.stderr)
        return 1
    if remove and session.get("name", "").startswith("unpushed"):
        print(f"{session['id']}: its worktree has commits not pushed; nothing removed", file=sys.stderr)
        return 1
    if alive(session.get("pid")):
        os.kill(session["pid"], signal.SIGTERM)
    for hook in session.pop("hooks", []):
        try:
            os.killpg(hook, signal.SIGTERM)
        except OSError:
            pass
    if session.get("pid"):
        try:
            os.remove(os.path.join(config_dir(), "sessions", f"{session['pid']}.json"))
        except OSError:
            pass
    session.update(pid=None, status=None, state="stopped")
    if remove:
        sessions.remove(session)
    save(sessions)
    if not remove:
        write_json(os.path.join(config_dir(), "jobs", session["id"], "state.json"), {"state": "stopped", "detail": "Stopped", "tempo": "idle"})
    print(f"{'removed' if remove else 'stopped'} {session['id']}")
    return 0


def state_file():
    """Where Claude Code keeps an account's state: beside ~/.claude for the default account."""
    if os.environ.get("CLAUDE_CONFIG_DIR"):
        return os.path.join(config_dir(), ".claude.json")
    return os.path.join(os.path.expanduser("~"), ".claude.json")


def mcp_add(name, command):
    try:
        with open(state_file()) as source:
            state = json.load(source)
    except (OSError, ValueError):
        state = {}
    state.setdefault("mcpServers", {})[name] = {"type": "stdio", "command": command[0], "args": command[1:]}
    write_json(state_file(), state)
    print(f"Added stdio MCP server {name} with command: {' '.join(command)} to user config")
    return 0


LOGIN_EXPIRES = "2027-01-01T00:00:00.000Z"


def login_expires():
    try:
        with open(os.path.join(config_dir(), "fake", "login-expires")) as source:
            return source.read().strip() or LOGIN_EXPIRES
    except OSError:
        return LOGIN_EXPIRES


def login():
    """`auth login`: Claude Code sends the user to the browser; this one signs in at once."""
    print("Opening the browser to sign in: https://claude.ai/oauth/authorize?fake=1", flush=True)
    fake = os.path.join(config_dir(), "fake")
    os.makedirs(fake, exist_ok=True)
    with open(os.path.join(fake, "logins.log"), "a") as log:
        log.write(f"{iso(now_ms())}\n")
    try:
        os.remove(os.path.join(fake, "login-expires"))
    except OSError:
        pass
    print("Login successful.", flush=True)
    return 0


def main(argv):
    if argv[:1] == ["--fake-worker"]:
        worker(argv[1], argv[2])
        return 0
    if argv[:1] == ["--fake-resume"]:
        worker(argv[1], None)
        return 0
    if argv[:1] == ["--fake-rewake"]:
        rewake(argv[1], argv[2], argv[3])
        return 0
    if argv[:1] == ["--fake-turn"]:
        turn(argv[1], argv[2])
        return 0
    # Each call kindric makes, one line each, for measurements: the real claude costs about
    # 0.55 s of processor per `agents --json`, this one almost nothing.
    calls = os.environ.get("FAKE_CLAUDE_CALLS")
    if calls:
        with open(calls, "a") as log:
            log.write(f"{time.time():.3f} {' '.join(argv)}\n")
    # Words that are not options or their values: the subcommand and the task.
    words = []
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg in WITH_VALUE:
            index += 2
            continue
        if not arg.startswith("-"):
            words.append(arg)
        index += 1
    if "--version" in argv or "-v" in argv:
        print(f"{VERSION} (Claude Code)")
        return 0
    if words[:2] == ["auth", "status"]:
        logged_in = "CLAUDE_CONFIG_DIR" in os.environ
        print(json.dumps({"loggedIn": logged_in, "authMethod": "claude.ai" if logged_in else "none", "loginExpiresAt": login_expires() if logged_in else None}))
        return 0 if logged_in else 1
    if words[:2] == ["auth", "login"]:
        return login()
    if words[:2] == ["mcp", "add"] and len(words) > 3:
        return mcp_add(words[2], words[3:])
    if words[:1] == ["agents"]:
        return agents(argv)
    if words[:1] == ["attach"] and len(words) > 1:
        return attach(words[1])
    if words[:1] in (["stop"], ["rm"]) and len(words) > 1:
        return stop(words[1], remove=words[0] == "rm")
    if "--bg" in argv:
        return background(argv, " ".join(words))
    print(f"fake claude: not imitated: {' '.join(argv)}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
