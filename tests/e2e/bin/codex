#!/usr/bin/env python3
"""A fake Codex for kindric's end-to-end tests: what kindric asks of a Codex account, in the shapes
codex 0.171.0 gives, without any model. Its sessions live in $CODEX_HOME/fake-threads.json, which
a journey may write before the app starts:

    [{"id": UUID, "name": str, "cwd": str, "status": "idle" | "working" | "approval" | "notLoaded",
      "archived": bool, "turns": [{"id": str, "status": "inProgress" | "completed" | ...}],
      "approval": {"itemId": str, "command": str, "reason": str}}]

A session in "approval" sends its approval to each client that joins it (thread/resume), as Codex
does; the answer is noted in its "decision", and the session goes back to "idle".

    codex login status                    exit 0 once $CODEX_HOME/fake-logged-in exists, else 1
    codex login                           a new login: writes fake-logged-in, noted in fake-logins.log
    codex app-server --listen stdio://    JSON-RPC, one message a line
    codex app-server daemon start|stop    the daemon of the account: the same JSON-RPC over a
                                          WebSocket on <CODEX_HOME>/app-server-control/app-server-control.sock
    codex resume <id> [--remote ADDR]     notes "<id> <current folder>" in fake-resumed.log, shows the
                                          session's name, then waits for its terminal to close
    codex queue --thread <id> --message <text> [...]
                                          notes the message in the session's "messages"
    anything else                         exit code 2

Each change of a session writes state_5.sqlite-wal, as Codex does: kindric watches it.
"""

import base64
import fcntl
import hashlib
import json
import os
import signal
import socket
import struct
import subprocess
import sys
import threading
import time
import uuid
from datetime import datetime


def home() -> str:
    return os.environ.get("CODEX_HOME") or os.path.join(os.path.expanduser("~"), ".codex")


def socket_path() -> str:
    return os.path.join(home(), "app-server-control", "app-server-control.sock")


def login() -> int:
    os.makedirs(home(), exist_ok=True)
    with open(os.path.join(home(), "fake-logged-in"), "w", encoding="utf-8") as file:
        file.write("chatgpt\n")
    with open(os.path.join(home(), "fake-logins.log"), "a", encoding="utf-8") as file:
        file.write("login\n")
    print("Successfully logged in")
    return 0


def login_status() -> int:
    if os.path.exists(os.path.join(home(), "fake-logged-in")):
        print("Logged in using ChatGPT")
        return 0
    print("Not logged in")
    return 1


class Threads:
    """The sessions file, read and written under a lock by every process of the fake."""

    def __init__(self) -> None:
        self.path = os.path.join(home(), "fake-threads.json")
        self.lock = open(os.path.join(home(), ".fake-threads.lock"), "w")

    def __enter__(self) -> list:
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        try:
            with open(self.path, encoding="utf-8") as file:
                self.threads = json.load(file)
        except (OSError, ValueError):
            self.threads = []
        self.before = json.dumps(self.threads, sort_keys=True)
        return self.threads

    def __exit__(self, *_: object) -> None:
        if json.dumps(self.threads, sort_keys=True) != self.before:
            with open(self.path + ".tmp", "w", encoding="utf-8") as file:
                json.dump(self.threads, file)
            os.replace(self.path + ".tmp", self.path)
            with open(os.path.join(home(), "state_5.sqlite-wal"), "a", encoding="utf-8") as file:
                file.write(".")
        fcntl.flock(self.lock, fcntl.LOCK_UN)


def loaded(thread: dict) -> bool:
    return not thread.get("archived") and thread.get("status", "idle") != "notLoaded"


def shown(thread: dict) -> dict:
    status = thread.get("status", "idle")
    if status == "working":
        state = {"type": "active", "activeFlags": []}
    elif status == "approval":
        state = {"type": "active", "activeFlags": ["waitingOnApproval"]}
    else:
        state = {"type": status}
    return {"id": thread["id"], "name": thread.get("name"), "cwd": thread.get("cwd", ""),
            "parentThreadId": None, "status": state, "path": thread.get("path")}


def rollout(thread_id: str) -> str:
    now = datetime.now()
    day = os.path.join(home(), "sessions", now.strftime("%Y"), now.strftime("%m"), now.strftime("%d"))
    os.makedirs(day, exist_ok=True)
    path = os.path.join(day, f"rollout-{now.strftime('%Y-%m-%dT%H-%M-%S')}-{thread_id}.jsonl")
    with open(path, "a", encoding="utf-8") as file:
        file.write("{}\n")
    return path


def find(threads: list, thread_id: str) -> dict:
    for thread in threads:
        if thread["id"] == thread_id:
            return thread
    raise KeyError(f"no session {thread_id}")


def answer(method: str, params: dict) -> object:
    if method == "initialize":
        return {"userAgent": "fake-codex/0.171.0", "codexHome": home()}
    if method in ("hooks/list",):
        return {"data": []}
    if method == "config/batchWrite":
        return {}
    with Threads() as threads:
        if method == "thread/loaded/list":
            return {"data": [thread["id"] for thread in threads if loaded(thread)], "nextCursor": None}
        if method in ("thread/read", "thread/resume"):
            return {"thread": shown(find(threads, params["threadId"]))}
        if method == "thread/list":
            excluded = set(params.get("excludedThreadIds") or [])
            listed = [shown(thread) for thread in threads if not thread.get("archived") and thread["id"] not in excluded]
            return {"data": listed[: params.get("limit") or 50], "nextCursor": None}
        if method == "thread/start":
            thread_id = str(uuid.uuid4())
            thread = {"id": thread_id, "name": None, "cwd": params.get("cwd", ""), "status": "idle", "archived": False, "turns": []}
            thread["path"] = rollout(thread_id)
            threads.append(thread)
            return {"thread": shown(thread)}
        if method == "thread/name/set":
            find(threads, params["threadId"])["name"] = params["name"]
            return {}
        if method == "thread/turns/list":
            return {"data": list(reversed(find(threads, params["threadId"]).get("turns", []))), "nextCursor": None}
        if method == "turn/interrupt":
            thread = find(threads, params["threadId"])
            for turn in thread.get("turns", []):
                if turn["id"] == params["turnId"]:
                    turn["status"] = "interrupted"
            thread["status"] = "idle"
            return {}
        if method == "thread/archive":
            thread = find(threads, params["threadId"])
            thread["archived"] = True
            thread["status"] = "notLoaded"
            return {}
    raise KeyError(f"{method} is not in the fake")


def approval_request(thread_id: str) -> dict | None:
    """The request Codex sends a client that joins a session waiting for an approval."""
    with Threads() as threads:
        try:
            thread = find(threads, thread_id)
        except KeyError:
            return None
        asked = thread.get("approval")
        if thread.get("status") != "approval" or not asked:
            return None
        command = asked.get("command", "")
        return {"jsonrpc": "2.0", "id": f"approval:{thread_id}", "method": "item/commandExecution/requestApproval",
                "params": {"threadId": thread_id, "itemId": asked.get("itemId", "item"), "command": f"/usr/bin/bash -lc '{command}'",
                           "commandActions": [{"type": "unknown", "command": command}], "reason": asked.get("reason")}}


def take_answer(message: dict) -> None:
    """The client's answer to an approval request: noted, the session goes on."""
    request = str(message.get("id", ""))
    if not request.startswith("approval:"):
        return
    with Threads() as threads:
        thread = find(threads, request.removeprefix("approval:"))
        thread["decision"] = (message.get("result") or {}).get("decision")
        thread["status"] = "idle"
        for turn in thread.get("turns", []):
            if turn["status"] == "inProgress":
                turn["status"] = "completed"


def reply(message: dict) -> dict | None:
    if "id" not in message:
        return None
    if "method" not in message:
        take_answer(message)
        return None
    try:
        return {"jsonrpc": "2.0", "id": message["id"], "result": answer(message.get("method", ""), message.get("params") or {})}
    except KeyError as error:
        return {"jsonrpc": "2.0", "id": message["id"], "error": {"code": -32601, "message": str(error)}}


def app_server() -> int:
    for line in sys.stdin:
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        answered = reply(message)
        if answered is not None:
            print(json.dumps(answered), flush=True)
    return 0


WEBSOCKET_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"


def read_exactly(connection: socket.socket, count: int) -> bytes:
    data = b""
    while len(data) < count:
        chunk = connection.recv(count - len(data))
        if not chunk:
            raise ConnectionError("closed")
        data += chunk
    return data


def send_frame(connection: socket.socket, opcode: int, payload: bytes) -> None:
    length = len(payload)
    if length < 126:
        header = struct.pack("!BB", 0x80 | opcode, length)
    elif length < 65536:
        header = struct.pack("!BBH", 0x80 | opcode, 126, length)
    else:
        header = struct.pack("!BBQ", 0x80 | opcode, 127, length)
    connection.sendall(header + payload)


def serve(connection: socket.socket) -> None:
    try:
        request = b""
        while b"\r\n\r\n" not in request:
            chunk = connection.recv(4096)
            if not chunk:
                return
            request += chunk
        key = next(line.split(b":", 1)[1].strip() for line in request.split(b"\r\n") if line.lower().startswith(b"sec-websocket-key:"))
        accept = base64.b64encode(hashlib.sha1(key + WEBSOCKET_GUID.encode()).digest())
        connection.sendall(b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + b"\r\n\r\n")
        while True:
            first, second = read_exactly(connection, 2)
            opcode, length = first & 0x0F, second & 0x7F
            if length == 126:
                length = struct.unpack("!H", read_exactly(connection, 2))[0]
            elif length == 127:
                length = struct.unpack("!Q", read_exactly(connection, 8))[0]
            mask = read_exactly(connection, 4) if second & 0x80 else b"\0\0\0\0"
            payload = bytes(byte ^ mask[index % 4] for index, byte in enumerate(read_exactly(connection, length)))
            if opcode == 8:
                return
            if opcode == 9:
                send_frame(connection, 10, payload)
                continue
            if opcode != 1:
                continue
            message = json.loads(payload)
            answered = reply(message)
            if answered is not None:
                send_frame(connection, 1, json.dumps(answered).encode())
            if message.get("method") == "thread/resume":
                asked = approval_request((message.get("params") or {}).get("threadId", ""))
                if asked is not None:
                    send_frame(connection, 1, json.dumps(asked).encode())
    except (ConnectionError, OSError, StopIteration, ValueError):
        return
    finally:
        connection.close()


def daemon() -> int:
    path = socket_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.path.exists(path):
        os.remove(path)
    server = socket.socket(socket.AF_UNIX)
    server.bind(path)
    server.listen(16)
    with open(os.path.join(home(), "fake-daemon.pid"), "w", encoding="utf-8") as file:
        file.write(str(os.getpid()))
    while True:
        connection, _ = server.accept()
        threading.Thread(target=serve, args=(connection,), daemon=True).start()


def daemon_listens() -> bool:
    probe = socket.socket(socket.AF_UNIX)
    try:
        probe.connect(socket_path())
        return True
    except OSError:
        return False
    finally:
        probe.close()


def daemon_start() -> int:
    if not daemon_listens():
        log = open(os.path.join(home(), "fake-daemon.log"), "a")
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "fake-daemon"], stdin=subprocess.DEVNULL,
                         stdout=log, stderr=log, start_new_session=True)
        deadline = time.time() + 5
        while not daemon_listens():
            if time.time() > deadline:
                print("fake codex: the daemon did not start", file=sys.stderr)
                return 1
            time.sleep(0.05)
    print(json.dumps({"status": "started", "socketPath": socket_path()}))
    return 0


def daemon_stop() -> int:
    try:
        with open(os.path.join(home(), "fake-daemon.pid"), encoding="utf-8") as file:
            os.kill(int(file.read().strip()), signal.SIGTERM)
    except (OSError, ValueError):
        pass
    print(json.dumps({"status": "stopped"}))
    return 0


def resume(thread_id: str) -> int:
    with open(os.path.join(home(), "fake-resumed.log"), "a", encoding="utf-8") as file:
        file.write(f"{thread_id} {os.getcwd()}\n")
    with Threads() as threads:
        try:
            name = find(threads, thread_id).get("name") or thread_id
        except KeyError:
            name = thread_id
    print(f"fake codex: session {name}", flush=True)
    sys.stdin.read()
    return 0


def queue(thread_id: str, text: str) -> int:
    with Threads() as threads:
        find(threads, thread_id).setdefault("messages", []).append(text)
    print(f"Queued message for thread {thread_id}.")
    return 0


def option(args: list[str], name: str) -> str | None:
    return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else None


def main(args: list[str]) -> int:
    if args[:2] == ["login", "status"]:
        return login_status()
    if args == ["login"]:
        return login()
    if args[:3] == ["app-server", "daemon", "start"]:
        return daemon_start()
    if args[:3] == ["app-server", "daemon", "stop"]:
        return daemon_stop()
    if args[:1] == ["app-server"]:
        return app_server()
    if args[:1] == ["fake-daemon"]:
        return daemon()
    if args[:1] == ["resume"] and len(args) > 1:
        return resume(args[1])
    if args[:1] == ["queue"] and option(args, "--thread") and option(args, "--message") is not None:
        return queue(option(args, "--thread") or "", option(args, "--message") or "")
    print(f"fake codex: {' '.join(args)} is not in the fake", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
